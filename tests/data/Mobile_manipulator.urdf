  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>arm_base_joint</joint_name><topic>Mobile_manipulator/arm_base_joint/cmd_pos</topic><p_gain>450</p_gain><cmd_max>90</cmd_max><cmd_min>-90</cmd_min></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>upper_arm_joint</joint_name><topic>Mobile_manipulator/upper_arm_joint/cmd_pos</topic><p_gain>600</p_gain><cmd_max>120</cmd_max><cmd_min>-120</cmd_min></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>forearm_joint</joint_name><topic>Mobile_manipulator/forearm_joint/cmd_pos</topic><p_gain>350</p_gain><cmd_max>70</cmd_max><cmd_min>-70</cmd_min></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>wrist_roll_joint</joint_name><topic>Mobile_manipulator/wrist_roll_joint/cmd_pos</topic><p_gain>125</p_gain><cmd_max>25</cmd_max><cmd_min>-25</cmd_min></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>wrist_pitch_joint</joint_name><topic>Mobile_manipulator/wrist_pitch_joint/cmd_pos</topic><p_gain>100</p_gain><cmd_max>20</cmd_max><cmd_min>-20</cmd_min></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>tool_flange_joint</joint_name><topic>Mobile_manipulator/tool_flange_joint/cmd_pos</topic><p_gain>60</p_gain><cmd_max>12</cmd_max><cmd_min>-12</cmd_min></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>left_finger_joint</joint_name><topic>Mobile_manipulator/left_finger_joint/cmd_pos</topic><p_gain>125</p_gain><cmd_max>25</cmd_max><cmd_min>-25</cmd_min></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>right_finger_joint</joint_name><topic>Mobile_manipulator/right_finger_joint/cmd_pos</topic><p_gain>125</p_gain><cmd_max>25</cmd_max><cmd_min>-25</cmd_min></plugin>
  </gazebo>
  <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>Mobile_manipulator/lidar_link</topic>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.1</min><max>12</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
  </gazebo>
  <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>Mobile_manipulator/imu_link</topic>
      </sensor>
  </gazebo>
  <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>Mobile_manipulator/camera_link</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.05</near><far>50</far></clip>
        </camera>
      </sensor>
  </gazebo>
</robot>
